# Settings for `docker compose up`. Copy to .env and edit.

# Database password (required). Generate: openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# Public URL where the site is reachable (used in checkout_url links).
PUBLIC_APP_URL=http://localhost:8080
WEB_PORT=8080

# Solana network: this app runs on Devnet only (test SOL, no real money).
SOLANA_CLUSTER=devnet
# Private server-side RPC, e.g. your QuickNode Devnet endpoint. Keep secret.
SOLANA_RPC_URL=
# RPC exposed to browsers (public!). Leave empty for the public cluster RPC.
PUBLIC_SOLANA_RPC_URL=
SOLANA_COMMITMENT=finalized

# Optional platform fee transfer per checkout.
PLATFORM_FEE_ADDRESS=
PLATFORM_FEE_LAMPORTS=0

# Stores create accounts at /register. Set to false to stop new sign-ups.
REGISTRATION_ENABLED=true

# Each store gets its own webhook secret (Dashboard → Settings). This is only a
# legacy fallback for data upgraded from the single-merchant version.
WEBHOOK_SECRET=
VITE_SITE_NAME=SolPay
VITE_CONTACT_EMAIL=
