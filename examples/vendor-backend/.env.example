# --- SolPay connection ------------------------------------------------------
# Base URL of the SolPay API (local backend, or your Render URL).
SOLPAY_API_URL=http://localhost:3003
# Secret API key from SolPay dashboard → API keys. Keep it server-side.
SOLPAY_SECRET_KEY=sk_...
# Your store's webhook secret: SolPay dashboard → Settings → Webhook signing secret.
SOLPAY_WEBHOOK_SECRET=

# --- This store -------------------------------------------------------------
PORT=4000
# Public URL of this vendor backend. SolPay must be able to reach
# ${PUBLIC_URL}/webhooks/solpay, and buyers are sent back to ${PUBLIC_URL}/orders/:id.
PUBLIC_URL=http://localhost:4000
STORE_NAME=Demo Store
# Where orders are persisted (JSON file).
DATA_FILE=./data/orders.json
