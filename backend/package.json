{
  "name": "solpay-backend",
  "version": "2.0.0",
  "description": "SolPay API: products, hosted checkout sessions, on-chain verification and webhooks",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsc -b && node --env-file-if-exists=.env dist/index.js",
    "build": "prisma generate --schema src/db/prisma/schema.prisma && tsc -b",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "prisma:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/db/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema src/db/prisma/schema.prisma"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.14.0",
    "@solana/web3.js": "1.98.4",
    "cors": "2.8.5",
    "express": "5.1.0",
    "prisma": "6.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
