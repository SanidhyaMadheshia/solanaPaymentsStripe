# Copy to backend/.env for local development (`npm run dev`).
# With docker compose, use the root .env instead (see ../.env.example).

# --- Required -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solpay

# Public URL of the frontend / hosted checkout (used to build checkout_url).
PUBLIC_APP_URL=http://localhost:5173

# --- Server ----------------------------------------------------------------
PORT=3003
# Extra comma-separated CORS origins (PUBLIC_APP_URL is always allowed).
CORS_ORIGINS=

# --- Solana ----------------------------------------------------------------
# Devnet only (test SOL, no real money).
SOLANA_CLUSTER=devnet
# Server-side RPC (e.g. a QuickNode Devnet endpoint). Keep this secret.
# Empty = public cluster RPC (heavily rate limited). Formerly QUICKNODE_RPC.
SOLANA_RPC_URL=
# RPC the browser uses to broadcast transactions. This is PUBLIC; never put a
# secret key here. Empty = public cluster RPC.
PUBLIC_SOLANA_RPC_URL=
# confirmed (faster) | finalized (safest, default)
SOLANA_COMMITMENT=finalized

# Optional platform fee added as a second transfer in every checkout.
PLATFORM_FEE_ADDRESS=
PLATFORM_FEE_LAMPORTS=0

# --- Timing ----------------------------------------------------------------
INVOICE_TTL_MINUTES=30
SESSION_TTL_MINUTES=10
VERIFY_TIMEOUT_SECONDS=120

# --- Webhooks --------------------------------------------------------------
# Every store signs with its own secret (Dashboard → Settings → Webhook signing
# secret). WEBHOOK_SECRET is only a legacy fallback: the first account to sign
# up on an upgraded instance inherits it so existing integrations keep working.
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=8

# --- Accounts --------------------------------------------------------------
# Stores register at /register. Set to false to stop new sign-ups.
REGISTRATION_ENABLED=true
# How long a dashboard login lasts.
SESSION_TTL_DAYS=30
